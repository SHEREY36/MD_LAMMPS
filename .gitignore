# Build directories
build*/
cmake-build-*/

# Compiled binaries and object files
*.o
*.a
*.so
*.so.*
*.dylib
*.exe
lmp
lmp_*

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
Makefile

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# LAMMPS run artifacts
log.lammps
runs/**/dump.*          # (was dump.*, which also hid src/dump.cpp and src/dump.h)
*.lammpstrj
restart.*
*.restart
tmp.*

# Fortran modules
*.mod
*.smod

# Dependency files
*.d
!cmake/etc/profile.d/

# ---- LAMMPS make-based build needs src/Makefile (the rule above ignores every Makefile)
!src/Makefile
# per-machine object/dependency files
src/Obj_*/

# ---- simulation outputs (keep inputs, scripts and templates only)
*.zip
*.dump
*.lammpstrj.gz
runs/**/restart*
runs/**/*.bin
runs/**/logs/
runs/**/velocity_profile.dat
runs/**/hcs_temperatures_*.dat
runs/**/collision_events.dat
# fresh USF: case directories and binaries are generated/built on each machine
runs/fresh_usf/AR*/
