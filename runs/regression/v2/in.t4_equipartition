# T4 elastic AR=2 rods, no shear: T_rot relaxes to T_tr (equipartition over 3+2 DOF),
# total energy conserved (diag resid), peculiar momentum conserved.
units lj
atom_style ellipsoid
atom_modify map array
boundary p p p
newton off
comm_modify vel yes
read_data rods_ar2_Trot02.data
set type 1 mass 1.000000357564170
variable meff equal 0.5
variable gref equal 2.26*sqrt(0.7)
variable kn equal 5.0*v_meff*v_gref^2/(4.0*0.004^2.5)
pair_style gran/spherocyl/mfix/history ${kn} 0 0 0 0 1
pair_coeff * * 0.5 0.5
neighbor 0.5 bin
neigh_modify delay 0 every 1 check yes one 200 page 20000
fix int all nve/spherocyl
timestep $(2.94*0.004/v_gref/40.0)
fix diag all spherocyl/diag 20000 t4 sample 2000
thermo 100000
thermo_style custom step f_diag[1] f_diag[2] f_diag[10] f_diag[3]
run 1400000
