# ============================================================
# Dilute USF baseline for spherocylinders (SLLOD-corrected)
# - 2000 particles by default
# - AR = (Lcyl + d)/d (default 2.0)
# - Lees-Edwards shear via fix deform remap v
# - SLLOD translational correction: Fx = -gdot*m*vy
# - Stress normalization uses translational temperature (temp/deform)
# ============================================================

units           lj
dimension       3
atom_style      ellipsoid
atom_modify     map array
boundary        p p p
newton          off
comm_modify     vel yes

# -------------------------
# User parameters
# -------------------------
variable        N_part equal 2000
variable        phi    equal 0.01
variable        d      equal 1.0
variable        AR     equal 2.0
variable        rho_p  equal 1.0
variable        e      equal 0.80
variable        mu     equal 0.0

variable        kn     equal 3.26e8
variable        kt     equal $(2.0/7.0*v_kn)
variable        gammat equal 0.0
variable        dampflag equal 1

variable        gdot   equal 1.8
variable        T0     equal 1.0e-3
variable        seed   equal 12345

variable        strain_transient equal 50.0
variable        strain_prod      equal 50.0

# -------------------------
# Geometry and mass
# AR = (Lcyl + d)/d
# pair_coeff uses R = d/2, H = Lcyl/2
# ellipsoid shape stores semi-axes (R, R, R+H)
# -------------------------
variable        R      equal 0.5*${d}
variable        Lcyl   equal (${AR}-1.0)*${d}
variable        H      equal 0.5*${Lcyl}
variable        C      equal ${R}+${H}
variable        Ltot   equal ${Lcyl}+${d}

variable        Vcaps  equal (4.0/3.0)*PI*${R}*${R}*${R}
variable        Vcyl   equal PI*${R}*${R}*(2.0*${H})
variable        Vp     equal ${Vcaps}+${Vcyl}
variable        m      equal ${rho_p}*${Vp}
variable        meff   equal ${m}/2.0

# Damping mapped from restitution
variable        lne    equal abs(ln(${e}))
variable        gamman equal 2.0*${lne}*sqrt(${kn}/${meff})/sqrt(PI*PI+${lne}*${lne})

# Collision-time-based timestep
variable        omega_d_sq equal ${kn}/${meff}-(${gamman}/2.0)^2
variable        tc         equal PI/sqrt(${omega_d_sq})
variable        dt_opt     equal ${tc}/50.0
timestep        ${dt_opt}

print "====================================="
print "SPHEROCYL USF (SLLOD-CORRECTED)"
print "N=${N_part}, phi=${phi}, AR=${AR}, e=${e}"
print "R=${R}, H=${H}, Ltot=${Ltot}, m=${m}"
print "gamman=${gamman}, tc=${tc}, dt=${dt_opt}"
print "ghat=$(v_gdot*v_d/sqrt(v_kn/(v_rho_p*v_d)))"
print "====================================="

# -------------------------
# Box setup from phi
# -------------------------
variable        Vbox  equal ${N_part}*${Vp}/${phi}
variable        L     equal ${Vbox}^(1.0/3.0)
variable        ncell equal ceil(${N_part}^(1.0/3.0))

lattice         sc 1.0
region          boxlat block 0 ${ncell} 0 ${ncell} 0 ${ncell} units lattice
create_box      1 boxlat
create_atoms    1 region boxlat

variable        Nnow equal count(all)
variable        Ndel equal $(v_Nnow - v_N_part)
if "${Ndel} > 0" then "delete_atoms random count ${Ndel} no all NULL ${seed}"

variable        scale equal ${L}/${ncell}
change_box      all x scale ${scale} y scale ${scale} z scale ${scale} remap
change_box      all triclinic

set             type 1 mass ${m}
set             type 1 shape ${R} ${R} ${C}
set             group all quat/random ${seed}

pair_style      gran/spherocyl/history ${kn} ${kt} ${gamman} ${gammat} ${mu} ${dampflag}
pair_coeff      * * ${R} ${H}

neighbor        0.5 bin
neigh_modify    delay 0 every 1 check yes

# -------------------------
# Stage 1: overlap-safe damping
# -------------------------
fix             int all nve/spherocyl
fix             damp all viscous 1.0
run             2000
unfix           damp

# -------------------------
# Stage 2: MB initialization (translation + rotation)
# -------------------------
velocity        all create ${T0} ${seed} mom yes rot no dist gaussian

# Draw random angular momentum then rescale to T0
variable        Lstd equal sqrt(${m}*${T0})
variable        seed_lx equal ${seed}+101
variable        seed_ly equal ${seed}+202
variable        seed_lz equal ${seed}+303
variable        lmx atom normal(0.0,v_Lstd,v_seed_lx)
variable        lmy atom normal(0.0,v_Lstd,v_seed_ly)
variable        lmz atom normal(0.0,v_Lstd,v_seed_lz)
set             group all angmom v_lmx v_lmy v_lmz

compute         Trot_init all temp/asphere dof rotate
compute         am_init all property/atom angmomx angmomy angmomz
run             0
variable        sf equal sqrt(${T0}/c_Trot_init)
variable        amx atom v_sf*c_am_init[1]
variable        amy atom v_sf*c_am_init[2]
variable        amz atom v_sf*c_am_init[3]
set             group all angmom v_amx v_amy v_amz
run             0

run             5000

# -------------------------
# Stage 3: shear + SLLOD correction
# -------------------------
reset_timestep  0
# ramp spans the ACTUAL box (change_box ... scale keeps it centred, ylo != 0)
velocity        all ramp vx 0.0 $(v_gdot*ly) y $(ylo) $(yhi) sum no

fix             shear all deform 1 xy erate ${gdot} remap v units box
# removed: manual SLLOD force double-counts the shear coupling with remap v
# variable        fsllod atom "-v_gdot*mass*vy"
# fix             sllod_corr all addforce v_fsllod 0.0 0.0

compute         Ttrans all temp/deform
compute         Trot   all temp/asphere dof rotate
compute         Press  all pressure Ttrans
thermo_modify   temp Ttrans

variable        p           equal (c_Press[1]+c_Press[2]+c_Press[3])/3.0
variable        tau         equal -c_Press[4]
variable        tau_over_p  equal v_tau/v_p

variable        gd2         equal (${gdot}*${d})^2
variable        pScaled     equal v_p/(${rho_p}*v_gd2)
variable        TtransScaled equal c_Ttrans/v_gd2
variable        TrotScaled  equal c_Trot/v_gd2
variable        Trot_over_Ttrans equal c_Trot/c_Ttrans

variable        vol equal vol
variable        n   equal ${N_part}/v_vol
variable        Pxxs equal c_Press[1]/(v_n*c_Ttrans)
variable        Pyys equal c_Press[2]/(v_n*c_Ttrans)
variable        Pzzs equal c_Press[3]/(v_n*c_Ttrans)
variable        Pxys equal c_Press[4]/(v_n*c_Ttrans)

variable        tilt_xy equal xy
variable        gamma_xy equal xy/ly

# Velocity-profile diagnostic
variable        Nbins_v equal round(${L}/${d})
variable        binwidth_red equal 1.0/${Nbins_v}
compute         chunks all chunk/atom bin/1d y lower ${binwidth_red} units reduced
fix             vprof all ave/chunk 200 50 10000 chunks vx vy vz density/number file velocity_profile.dat

thermo          1000
thermo_style    custom step time temp c_Trot v_gamma_xy v_tilt_xy &
                v_p v_tau v_tau_over_p v_pScaled v_TtransScaled v_TrotScaled

variable        steps_transient equal round(v_strain_transient/(${gdot}*${dt_opt}))
print "Transient run: ${steps_transient} steps (${strain_transient} strain units)"
run             ${steps_transient}
run             ${steps_transient}
write_restart   restart_after_transient.shear

variable        steps_prod equal round(v_strain_prod/(${gdot}*${dt_opt}))
print "Production run: ${steps_prod} steps (${strain_prod} strain units)"

fix             avCh all ave/time 100 50 5000 &
                v_pScaled v_tau_over_p v_TtransScaled v_TrotScaled v_gamma_xy v_tilt_xy &
                file chialvo_stats.dat

fix             avShear all ave/time 200 50 10000 &
                v_Pxxs v_Pyys v_Pzzs v_Pxys v_gamma_xy v_tilt_xy &
                file shear_stats.dat

fix             avTemp all ave/time 100 50 5000 &
                c_Ttrans c_Trot v_Trot_over_Ttrans v_gamma_xy v_tilt_xy &
                file temperature_stats.dat

fix             avRaw all ave/time 100 50 5000 &
                c_Press[1] c_Press[2] c_Press[3] c_Press[4] &
                v_p v_tau v_tilt_xy c_Ttrans c_Trot &
                file raw_stress.dat

run             ${steps_prod}
run             ${steps_prod}
run             ${steps_prod}

write_restart   restart_final.shear

print "Done. Outputs:"
print "  chialvo_stats.dat"
print "  shear_stats.dat"
print "  temperature_stats.dat"
print "  raw_stress.dat"
print "  velocity_profile.dat"
