# ============================================================
# Homogeneous Cooling State (HCS) for smooth spherocylinders
# SMALL SYSTEM — matches MFIX setup (~2003 particles)
#
# Uses read_data from gen_spherocyl_lammps.py output instead of
# lattice-based create_atoms. This avoids clustering instabilities
# that arise in large (N=40000) systems.
#
# Run gen_spherocyl_lammps.py first:
#   python3 gen_spherocyl_lammps.py --phi 0.01 --AR 2.0 --d 1.0 \
#       --rho 0.763944 --T_tr 1.0 --T_rot 1.0 --seed 42 \
#       --outfile spherocyl_hcs.data
# ============================================================

units           lj
dimension       3
atom_style      ellipsoid
atom_modify     map array
boundary        p p p
newton          off
comm_modify     vel yes

# -------------------------
# User parameters
# -------------------------
variable        d      equal 1.0
variable        AR     equal 2.0
variable        rho_p  equal 0.763944
variable        phi    equal 0.01

variable        mode string B
variable        e      equal 0.90
variable        mu     equal 0.0

variable        kn     equal 3.26e8
variable        kt     equal 0.0
variable        gammat equal 0.0
variable        dampflag equal 1

variable        T0            equal 1.0
variable        T_tr0         equal 1.0
variable        T_rot0_modeA  equal 0.01
variable        seed          equal 12349

variable        Nrelax_steps        equal 5000
variable        Nequil_nodiss_steps equal 200000
variable        Nprod_steps         equal 1000000000
variable        t_prod_target       equal 500.0

# -------------------------
# Geometry
# -------------------------
variable        R      equal 0.5*${d}
variable        Lcyl   equal (${AR}-1.0)*${d}
variable        H      equal 0.5*${Lcyl}
variable        C      equal ${R}+${H}
variable        Ltot   equal ${Lcyl}+${d}

variable        Vcaps  equal (4.0/3.0)*PI*${R}*${R}*${R}
variable        Vcyl   equal PI*${R}*${R}*(2.0*${H})
variable        Vp     equal ${Vcaps}+${Vcyl}
variable        m      equal ${rho_p}*${Vp}
variable        meff   equal ${m}/2.0

# Principal moments (for temperature diagnostics)
variable        Iperp equal (PI/48.0)*${rho_p}*${d}*${d}*${Lcyl}*${Lcyl}*${Lcyl} + &
                        (PI/24.0)*${rho_p}*${d}*${d}*${d}*${Lcyl}*${Lcyl} + &
                        (3.0*PI/64.0)*${rho_p}*${d}*${d}*${d}*${d}*${Lcyl} + &
                        (PI/60.0)*${rho_p}*${d}*${d}*${d}*${d}*${d}
variable        Ipar  equal (PI/32.0)*${rho_p}*${d}*${d}*${d}*${d}*${Lcyl} + &
                        (PI/60.0)*${rho_p}*${d}*${d}*${d}*${d}*${d}

# Damping
variable        gamman_nodiss equal 0.0
variable        lne_diss      equal abs(ln(${e}))
variable        gamman_diss   equal 2.0*${lne_diss}*sqrt(${kn}/${meff})/sqrt(PI*PI+${lne_diss}*${lne_diss})

# Timestep
variable        omega_d_sq equal ${kn}/${meff}-(${gamman_diss}/2.0)^2
variable        tc         equal PI/sqrt(${omega_d_sq})
variable        dt_opt     equal ${tc}/50.0
variable        Nprod_blocks equal ceil(${t_prod_target}/(${Nprod_steps}*${dt_opt}))
timestep        ${dt_opt}

# =========================================================
# READ DATA — replaces lattice-based create_atoms
# The data file was generated by gen_spherocyl_lammps.py
# with positions, orientations, velocities, and angular momenta
# already initialized (random, non-overlapping, MB distributed).
# =========================================================
read_data       spherocyl_hcs.data

# atom_style ellipsoid computes mass from density * ellipsoid_volume,
# but our "ellipsoid" shape (R,R,C) doesn't match the true spherocylinder
# volume — it's just a storage container for the quaternion.  Override
# the mass to the correct spherocylinder value.
set             type 1 mass ${m}

# Count particles from the data file
variable        N_part equal count(all)

print "========================================"
print "SPHEROCYL HCS - MODE ${mode} (read_data)"
print "N=${N_part}, phi=${phi}, AR=${AR}, e=${e}"
print "R=${R}, H=${H}, Ltot=${Ltot}, m=${m}"
print "gamman_nodiss=${gamman_nodiss}, gamman_diss=${gamman_diss}"
print "tc=${tc}, dt=${dt_opt}"
print "Target production time = ${t_prod_target}"
print "Computed production blocks = ${Nprod_blocks}"
print "========================================"

# -------------------------
# Pair style (start non-dissipative)
# -------------------------
pair_style      gran/spherocyl/history ${kn} ${kt} ${gamman_nodiss} ${gammat} ${mu} ${dampflag}
pair_coeff      * * ${R} ${H}

neighbor        0.5 bin
neigh_modify    delay 0 every 1 check yes

fix             int all nve/spherocyl

# -------------------------
# Stage 1: overlap cleanup (brief, since particles are already non-overlapping)
# -------------------------
fix             damp all viscous 1.0
run             ${Nrelax_steps}
unfix           damp

# -------------------------
# Stage 2: MB initialization
# Velocities and angular momenta are ALREADY set by the data file.
# We only need to do the cleanup / rescaling steps here.
# If you want to reinitialize from scratch, uncomment the velocity
# commands below. Otherwise the data file values are used.
# -------------------------

# (Optional) Re-initialize translational velocities:
# velocity all create ${T0} ${seed} mom yes rot no dist gaussian

# Compute T_tr and T_rot diagnostics
compute         KEtr all ke
compute         am all property/atom angmomx angmomy angmomz
compute         quat all property/atom quati quatj quatk quatw

variable        ux atom 2.0*(c_quat[1]*c_quat[3] + c_quat[2]*c_quat[4])
variable        uy atom 2.0*(c_quat[2]*c_quat[3] - c_quat[1]*c_quat[4])
variable        uz atom 1.0 - 2.0*(c_quat[1]*c_quat[1] + c_quat[2]*c_quat[2])

variable        L2 atom c_am[1]*c_am[1] + c_am[2]*c_am[2] + c_am[3]*c_am[3]
variable        Lpar atom c_am[1]*v_ux + c_am[2]*v_uy + c_am[3]*v_uz
variable        Krot_atom atom 0.5*((v_L2 - v_Lpar*v_Lpar)/(v_Iperp+1.0e-30) + (v_Lpar*v_Lpar)/(v_Ipar+1.0e-30))
compute         KErot all reduce sum v_Krot_atom
run             0

# Enforce smooth-rod kinematics (remove axial spin)
variable        amx_noax atom c_am[1]-v_Lpar*v_ux
variable        amy_noax atom c_am[2]-v_Lpar*v_uy
variable        amz_noax atom c_am[3]-v_Lpar*v_uz
set             group all angmom v_amx_noax v_amy_noax v_amz_noax
run             0

# Rescale rotational temperature if needed (Mode A vs B)
if "${mode} == A" then &
    "variable T_rot_target equal ${T_rot0_modeA}" &
else &
    "variable T_rot_target equal ${T0}"

variable        Trot_raw equal c_KErot/${N_part}
variable        sf_rot equal sqrt(v_T_rot_target/(v_Trot_raw+1.0e-30))
variable        amx atom v_sf_rot*c_am[1]
variable        amy atom v_sf_rot*c_am[2]
variable        amz atom v_sf_rot*c_am[3]
set             group all angmom v_amx v_amy v_amz
run             0

variable        Ttr_init equal 2.0*c_KEtr/(3.0*${N_part})
variable        Trot_init equal c_KErot/${N_part}
print "Initialized T_tr = ${Ttr_init}"
print "Initialized T_rot = ${Trot_init}"

# -------------------------
# Stage 3: non-dissipative equilibration at e=1
# -------------------------
print "Nondissipative pre-equilibration: ${Nequil_nodiss_steps} steps"
run             ${Nequil_nodiss_steps}
write_restart   restart_after_nodiss_hcs_${mode}_e${e}.dat

# -------------------------
# Stage 4: switch to target dissipation
# -------------------------
unfix           int
pair_style      gran/spherocyl/history ${kn} ${kt} ${gamman_diss} ${gammat} ${mu} ${dampflag}
pair_coeff      * * ${R} ${H}
fix             int all nve/spherocyl
reset_timestep  0
run             0
fix             colcount all count/collisions 1000

variable        t       equal time
variable        Ttr     equal 2.0*c_KEtr/(3.0*${N_part})
variable        Tro     equal c_KErot/${N_part}
variable        ratio   equal v_Ttr/(v_Tro+1.0e-30)
variable        Ttotal  equal (3.0*v_Ttr+2.0*v_Tro)/5.0

thermo          1000
thermo_style    custom step time v_Ttr v_Tro v_ratio v_Ttotal

fix             log_temps all print 200 "${t} ${Ttr} ${Tro} ${ratio} ${Ttotal}" &
                file hcs_temperatures_${mode}_e${e}.dat screen no title "# time T_trans T_rot T_tr/T_rot T_total"

print "Production: ${Nprod_blocks} blocks x ${Nprod_steps} steps"
print "Mode ${mode}: e=${e}"

variable        ib loop ${Nprod_blocks}
label           loop_prod
run             ${Nprod_steps}

shell awk 'BEGIN{N=${N_part};dt=${dt_opt};print "# time cpp coll_rate_per_particle"} NR>1{t=$1*dt;cpp=2*$3/N;if(NR==2){rate=0.0}else{rate=(cpp-cpp_prev)/(t-t_prev+1.0e-30)};printf "%.12g %.12g %.12g\n",t,cpp,rate;t_prev=t;cpp_prev=cpp}' collision_events.dat > collision_cpp_${mode}_e${e}.dat

write_restart   restart_hcs_${mode}_e${e}.dat

print "============================================"
print "Done. Output files:"
print "  hcs_temperatures_${mode}_e${e}.dat"
print "  collision_cpp_${mode}_e${e}.dat"
print "============================================"
